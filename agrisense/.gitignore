# =====================================================
# DATA & MODELS (Local-only, DO NOT COMMIT)
# =====================================================

# Raw data files
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.json
data/raw/*.parquet
data/raw/*.pkl
data/raw/*.pickle

# Processed data
data/processed/*.csv
data/processed/*.parquet
data/processed/*.pkl
data/processed/*.json

# External data
data/external/*.csv
data/external/*.xlsx
data/external/*.json

# Models & checkpoints
outputs/models/*.pkl
outputs/models/*.joblib
outputs/models/*.h5
outputs/models/*.pt
outputs/models/*.pth
outputs/models/*.model
outputs/models/*.onnx

# Predictions & Results
outputs/predictions/*.csv
outputs/predictions/*.json
outputs/predictions/*.xlsx

# Figures & Charts
outputs/figures/*.png
outputs/figures/*.jpg
outputs/figures/*.pdf
outputs/figures/*.svg

